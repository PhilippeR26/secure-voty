# Proof server (an instance of proofServer/, see proofServer/INSTALL.md). Pick one of the three, then restart `npm run dev`.
# 1. On this machine (default when PROOF_SERVER_URL is absent)
PROOF_SERVER_URL=http://localhost:3030
# 2. On the local network: address of the machine that runs it and LAN_PORT of its instance, no key
# PROOF_SERVER_URL=http://<lan-ip>:3030
# 3. Through the Internet: https://<name>.duckdns.org/<instance>, with the key its owner gave you
# PROOF_SERVER_URL=https://<name>.duckdns.org/sepolia
# PROOF_SERVER_API_KEY=
