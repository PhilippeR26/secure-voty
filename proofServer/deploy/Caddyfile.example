# Generated by ./proof-server.sh caddyfile — do not edit, run the command again instead.
{
	http_port 8080
	https_port 8443
	admin localhost:2019
	storage file_system {
		root /home/you/secure-voty/proofServer/state/caddy
	}
	log {
		output file /home/you/secure-voty/proofServer/logs/caddy.log {
			roll_size 5MiB
			roll_keep 3
		}
	}
}

myproof.duckdns.org {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	request_body {
		max_size 1MB
	}
	handle_path /mainnet/* {
		reverse_proxy 127.0.0.1:4031 {
			flush_interval -1
		}
	}
	handle_path /sepolia/* {
		reverse_proxy 127.0.0.1:4030 {
			flush_interval -1
		}
	}
	handle {
		respond "Not found" 404
	}
}
